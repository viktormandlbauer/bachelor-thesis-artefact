{
  "realm": "case-poc",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "case-manager",
        "description": "Staff role required for all management-service endpoints (plan §5.2)."
      }
    ]
  },
  "clients": [
    {
      "clientId": "management-api",
      "name": "Management API",
      "description": "Bearer-only style client for management-service; tokens are obtained via password grant for the POC demo.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "staff",
      "email": "staff@case-poc.local",
      "firstName": "Staff",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "staff-password",
          "temporary": false
        }
      ],
      "realmRoles": ["case-manager"]
    },
    {
      "username": "intern",
      "email": "intern@case-poc.local",
      "firstName": "Intern",
      "lastName": "NoRole",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "intern-password",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}
